{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Condition_StatusChanged": {
        "actions": {
          "Switch_on_Status_value": {
            "cases": {
              "Case_UnderReview": {
                "actions": {
                  "SendEmail_UnderReview": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "To": "@triggerOutputs()?['body/Applicant/Email']",
                        "Subject": "[SPARK] Application Update: Under Review",
                        "Body": "<p>Hello,</p><p>Your application is being reviewed. We will get back to you shortly.</p>"
                      }
                    },
                    "runAfter": {},
                    "type": "OpenApiConnection"
                  }
                },
                "case": "Under Review"
              },
              "Case_DiscussionScheduled": {
                "actions": {
                  "SendEmail_DiscussionScheduled": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "To": "@triggerOutputs()?['body/Applicant/Email']",
                        "Subject": "[SPARK] Application Update: Discussion Scheduled",
                        "Body": "<p>Great news! The manager wants to discuss your application. Remarks: @{triggerOutputs()?['body/ManagerRemarks']}</p>"
                      }
                    },
                    "runAfter": {},
                    "type": "OpenApiConnection"
                  }
                },
                "case": "Discussion Scheduled"
              },
              "Case_Shortlisted": {
                "actions": {
                  "SendEmail_Shortlisted": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "To": "@triggerOutputs()?['body/Applicant/Email']",
                        "Subject": "[SPARK] Application Update: Shortlisted",
                        "Body": "<p>Congratulations! You have been shortlisted for the opportunity.</p>"
                      }
                    },
                    "runAfter": {},
                    "type": "OpenApiConnection"
                  }
                },
                "case": "Shortlisted"
              },
              "Case_Rejected": {
                "actions": {
                  "SendEmail_Rejected": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "To": "@triggerOutputs()?['body/Applicant/Email']",
                        "Subject": "[SPARK] Application Update: Status",
                        "Body": "<p>Thank you for applying. Unfortunately, we have decided to move forward with other candidates at this time. Please explore other opportunities: <a href='https://visteon.sharepoint.com/sites/SPARK'>SPARK Platform</a></p>"
                      }
                    },
                    "runAfter": {},
                    "type": "OpenApiConnection"
                  }
                },
                "case": "Rejected"
              },
              "Case_Onboarded": {
                "actions": {
                  "SendEmail_Onboarded": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "To": "@triggerOutputs()?['body/Applicant/Email']",
                        "Subject": "[SPARK] Application Update: Welcome!",
                        "Body": "<p>Welcome to the team! You have been onboarded. Your manager will share next steps.</p>"
                      }
                    },
                    "runAfter": {},
                    "type": "OpenApiConnection"
                  },
                  "Get_Opportunity": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "GetItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "https://visteon.sharepoint.com/sites/SPARK",
                        "table": "Opportunities",
                        "id": "@triggerOutputs()?['body/OpportunityId/Id']"
                      }
                    },
                    "runAfter": {
                      "SendEmail_Onboarded": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection"
                  },
                  "Update_Opportunity_OpeningsFilled": {
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "https://visteon.sharepoint.com/sites/SPARK",
                        "table": "Opportunities",
                        "id": "@triggerOutputs()?['body/OpportunityId/Id']",
                        "item/OpeningsFilled": "@add(outputs('Get_Opportunity')?['body/OpeningsFilled'], 1)"
                      }
                    },
                    "runAfter": {
                      "Get_Opportunity": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection"
                  }
                },
                "case": "Onboarded"
              }
            },
            "default": {
              "actions": {}
            },
            "expression": "@triggerOutputs()?['body/Status/Value']",
            "runAfter": {},
            "type": "Switch"
          }
        },
        "expression": {
          "and": [
            {
              "not": {
                "equals": [
                  "@triggerOutputs()?['body/Status/Value']",
                  "@triggerWindow()?['body/Status/Value']"
                ]
              }
            },
            {
              "contains": [
                "Under Review, Discussion Scheduled, Shortlisted, Rejected, Onboarded",
                "@triggerOutputs()?['body/Status/Value']"
              ]
            }
          ]
        },
        "runAfter": {},
        "type": "If"
      },
      "Error_Handling_Scope": {
        "actions": {
          "Send_Error_Email": {
            "inputs": {
              "host": {
                "connectionName": "shared_office365",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "To": "admin@visteon.com",
                "Subject": "Flow Failure: Status Change Notify",
                "Body": "An error occurred in the flow processing Application ID: @{triggerOutputs()?['body/ID']}"
              }
            },
            "runAfter": {},
            "type": "OpenApiConnection"
          }
        },
        "runAfter": {
          "Condition_StatusChanged": [
            "Failed",
            "TimedOut"
          ]
        },
        "type": "Scope"
      }
    },
    "triggers": {
      "When_an_item_is_modified": {
        "inputs": {
          "host": {
            "connectionName": "shared_sharepointonline",
            "operationId": "GetOnUpdatedItems",
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://visteon.sharepoint.com/sites/SPARK",
            "table": "Applications"
          }
        },
        "type": "OpenApiConnection"
      }
    }
  }
}
